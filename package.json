{
  "name": "legit-assets",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.mjs",
    "db:deploy": "prisma migrate deploy",
    "smm:sync": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/smm-sync.ts",
    "admin:seed": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/admin-seed.ts",
    "security:audit": "node scripts/security-audit.mjs",
    "preflight": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/preflight.ts",
    "worker": "node --import tsx --env-file-if-exists=.env scripts/commerce-worker.ts",
    "env:init": "node scripts/init-env.mjs",
    "launch:check": "npm run preflight -- --strict"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "6.19.0",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui-react": "^5.0.1",
    "decimal.js": "^10.6.0",
    "framer-motion": "^12.0.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0"
    }
  }
}
