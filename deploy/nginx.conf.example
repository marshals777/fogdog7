# Install in nginx http context. Replace domain/certificate paths before nginx -t.
# Keep the application and PostgreSQL on private interfaces; never serve the project folder as root.
limit_req_zone $binary_remote_addr zone=legit_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=legit_auth:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=legit_conn:10m;
server {
    listen 80;
    server_name shop.example.com;
    return 301 https://shop.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name shop.example.com;
    ssl_certificate /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;
    add_header Strict-Transport-Security "max-age=15552000" always;
    client_max_body_size 1m;
    limit_conn legit_conn 30;
    location ~* (^/\.(env|git|svn|hg)|^/(src|prisma|node_modules|backups?)/|^/_next/server/|\.(sql|sqlite|db|bak|zip|map)$) {
        return 404;
    }
    location ~ ^/api/(auth/|admin/login) {
        limit_req zone=legit_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host shop.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /api/ {
        limit_req zone=legit_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host shop.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 130s;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host shop.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 130s;
        # Do not cache HTML: CSP nonce and authenticated content must remain per request.
    }
}
