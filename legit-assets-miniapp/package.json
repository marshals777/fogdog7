{
  "name": "legit-assets",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/start.mjs db migrate dev",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.mjs",
    "db:deploy": "node --env-file-if-exists=.env scripts/start.mjs db migrate deploy",
    "smm:sync": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/tools.ts smm-sync",
    "admin:seed": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/tools.ts admin-seed",
    "security:audit": "node scripts/start.mjs audit",
    "preflight": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/tools.ts preflight",
    "worker": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/tools.ts worker",
    "env:init": "node scripts/start.mjs env",
    "env:railway": "node scripts/start.mjs env --railway",
    "launch:check": "npm run preflight -- --strict",
    "assets:extract": "node scripts/start.mjs assets extract",
    "assets:pack": "node scripts/start.mjs assets pack",
    "db:check": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/tools.ts db-check",
    "db:local": "npm run deploy:files && docker compose --env-file .env -f compose.site.yml up --build -d",
    "db:status": "node --env-file-if-exists=.env scripts/start.mjs db migrate status",
    "deploy:files": "node scripts/start.mjs deploy-files",
    "verify": "npm test && npm run typecheck && npm run build && npm run security:audit",
    "db:cleanup": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/tools.ts db-cleanup",
    "db:storage": "node --import tsx --conditions=react-server --env-file-if-exists=.env scripts/tools.ts db-storage",
    "db:backup": "node --env-file-if-exists=.env scripts/start.mjs backup",
    "test:launch": "node tests/launch.integration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "6.19.0",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui-react": "^5.0.1",
    "decimal.js": "^10.6.0",
    "framer-motion": "^12.0.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0"
    }
  }
}
