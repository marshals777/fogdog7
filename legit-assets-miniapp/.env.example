# Основні дані сервера. Бот @LegitAssetsBot вже заданий у коді.
# SQLite is automatic. Attach one Railway Volume at /data.
# No DATABASE_URL, DIRECT_URL or separate Postgres service is needed.
AUTO_MIGRATE="true"
START_COMMERCE_WORKER="true"
NEXT_PUBLIC_SITE_URL=""
BOT_TOKEN=""
ADMIN_ID=""

# Ці приватні ключі генерує npm run env:init -- --domain=your-domain.com.
# Для наявної бази збережіть попередній DELIVERY_ENCRYPTION_KEY.
DELIVERY_ENCRYPTION_KEY=""
INTERNAL_API_SECRET=""
CRON_SECRET=""
BOT_WEBHOOK_SECRET=""
BOT_BRIDGE_SECRET=""
# Адреса вашого Python-бота для читання балансу (HTTPS).
BOT_BRIDGE_URL=""

# Заповнюються для відповідних покупок/каталогів, а не для відкриття інтерфейсу.
MARKETAPP_API_TOKEN=""
TONCENTER_API_KEY=""
LZT_TOKEN=""
SMM_API_KEY=""
SMM_CATALOG_MODE="jap"
SMM_APPROVED_SERVICE_MAP_JSON=""
SMM_LIVE_ORDERS_ENABLED="false"
STARS_USDT_PER_STAR=""
MARKET_LIVE_ORDERS_ENABLED="false"
